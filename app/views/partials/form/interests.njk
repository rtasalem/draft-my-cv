<h5 class="subtitle is-4">
  <strong>Skills & Interests (optional)</strong>
</h5>
<hr>

<div class="field">
  <p class="control has-icons-left">
    <input 
          class="input" 
          id="technical-skills"
          name="technicalSkills"
          type="text" 
          placeholder="Technical skills, e.g. software and programming languages"
        >
    <span class="icon is-small is-left">
      <i class="fa-solid fa-laptop-code"></i>
    </span>
  </p>
</div>

<div class="field">
  <p class="control has-icons-left">
    <input 
          class="input" 
          id="language-skills"
          name="languageSkills"
          type="text" 
          placeholder="Languages and your level of fluency"
        >
    <span class="icon is-small is-left">
      <i class="fa-solid fa-language"></i>
    </span>
  </p>
</div>

<div class="field">
  <p class="control has-icons-left">
    <input 
          class="input" 
          id="laboratory-skills"
          name="laboratorySkills"
          type="text" 
          placeholder="Laboratory techniques or tools (if applicable)"
        >
    <span class="icon is-small is-left">
      <i class="fa-solid fa-flask"></i>
    </span>
  </p>
</div>

<div class="field">
  <p class="control has-icons-left">
    <input 
          class="input" 
          id="interests"
          name="interests"
          type="text" 
          placeholder="Interests or hobbies that may spark conversation"
        >
    <span class="icon is-small is-left">
      <i class="fa-solid fa-heart"></i>
    </span>
  </p>
</div>
